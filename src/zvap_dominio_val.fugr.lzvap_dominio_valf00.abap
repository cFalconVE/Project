*---------------------------------------------------------------------*
*    view related FORM routines
*---------------------------------------------------------------------*
*...processing: ZVAP_DOMINIO_VAL................................*
FORM GET_DATA_ZVAP_DOMINIO_VAL.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM ZAP_DOMINIOS_VAL WHERE
(VIM_WHERETAB) .
    CLEAR ZVAP_DOMINIO_VAL .
ZVAP_DOMINIO_VAL-MANDT =
ZAP_DOMINIOS_VAL-MANDT .
ZVAP_DOMINIO_VAL-BUKRS =
ZAP_DOMINIOS_VAL-BUKRS .
ZVAP_DOMINIO_VAL-SERVICIO =
ZAP_DOMINIOS_VAL-SERVICIO .
ZVAP_DOMINIO_VAL-DOMIPOSTMAN =
ZAP_DOMINIOS_VAL-DOMIPOSTMAN .
ZVAP_DOMINIO_VAL-DOMINIOTEST =
ZAP_DOMINIOS_VAL-DOMINIOTEST .
ZVAP_DOMINIO_VAL-DOMINIOPROD =
ZAP_DOMINIOS_VAL-DOMINIOPROD .
ZVAP_DOMINIO_VAL-DOMINIOPET =
ZAP_DOMINIOS_VAL-DOMINIOPET .
<VIM_TOTAL_STRUC> = ZVAP_DOMINIO_VAL.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_ZVAP_DOMINIO_VAL .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO ZVAP_DOMINIO_VAL.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_ZVAP_DOMINIO_VAL-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM ZAP_DOMINIOS_VAL WHERE
  BUKRS = ZVAP_DOMINIO_VAL-BUKRS AND
  SERVICIO = ZVAP_DOMINIO_VAL-SERVICIO .
    IF SY-SUBRC = 0.
    DELETE ZAP_DOMINIOS_VAL .
    ENDIF.
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM ZAP_DOMINIOS_VAL WHERE
  BUKRS = ZVAP_DOMINIO_VAL-BUKRS AND
  SERVICIO = ZVAP_DOMINIO_VAL-SERVICIO .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR ZAP_DOMINIOS_VAL.
    ENDIF.
ZAP_DOMINIOS_VAL-MANDT =
ZVAP_DOMINIO_VAL-MANDT .
ZAP_DOMINIOS_VAL-BUKRS =
ZVAP_DOMINIO_VAL-BUKRS .
ZAP_DOMINIOS_VAL-SERVICIO =
ZVAP_DOMINIO_VAL-SERVICIO .
ZAP_DOMINIOS_VAL-DOMIPOSTMAN =
ZVAP_DOMINIO_VAL-DOMIPOSTMAN .
ZAP_DOMINIOS_VAL-DOMINIOTEST =
ZVAP_DOMINIO_VAL-DOMINIOTEST .
ZAP_DOMINIOS_VAL-DOMINIOPROD =
ZVAP_DOMINIO_VAL-DOMINIOPROD .
ZAP_DOMINIOS_VAL-DOMINIOPET =
ZVAP_DOMINIO_VAL-DOMINIOPET .
    IF SY-SUBRC = 0.
    UPDATE ZAP_DOMINIOS_VAL ##WARN_OK.
    ELSE.
    INSERT ZAP_DOMINIOS_VAL .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_ZVAP_DOMINIO_VAL-UPD_FLAG,
STATUS_ZVAP_DOMINIO_VAL-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
