ZAP_DOMINIOS_VAL-SERVICIO .
ZVAP_DOMINIO_VAL-DOMIPOSTMAN =
ZAP_DOMINIOS_VAL-DOMIPOSTMAN .
ZVAP_DOMINIO_VAL-DOMINIOTEST =
ZAP_DOMINIOS_VAL-DOMINIOTEST .
ZVAP_DOMINIO_VAL-DOMINIOPROD =
ZAP_DOMINIOS_VAL-DOMINIOPROD .
ZVAP_DOMINIO_VAL-DOMINIOPET =
ZAP_DOMINIOS_VAL-DOMINIOPET .
ENDFORM.
*---------------------------------------------------------------------*
FORM CORR_MAINT_ZVAP_DOMINIO_VAL USING VALUE(CM_ACTION) RC.
  DATA: RETCODE LIKE SY-SUBRC, COUNT TYPE I, TRSP_KEYLEN TYPE SYFLENG.
  FIELD-SYMBOLS: <TAB_KEY_X> TYPE X.
  CLEAR RC.
MOVE ZVAP_DOMINIO_VAL-BUKRS TO
ZAP_DOMINIOS_VAL-BUKRS .
MOVE ZVAP_DOMINIO_VAL-SERVICIO TO
ZAP_DOMINIOS_VAL-SERVICIO .
MOVE ZVAP_DOMINIO_VAL-MANDT TO
ZAP_DOMINIOS_VAL-MANDT .
  CORR_KEYTAB             =  E071K.
  CORR_KEYTAB-OBJNAME     = 'ZAP_DOMINIOS_VAL'.
  IF NOT <vim_corr_keyx> IS ASSIGNED.
    ASSIGN CORR_KEYTAB-TABKEY TO <vim_corr_keyx> CASTING.
  ENDIF.
  ASSIGN ZAP_DOMINIOS_VAL TO <TAB_KEY_X> CASTING.
  PERFORM VIM_GET_TRSPKEYLEN
    USING 'ZAP_DOMINIOS_VAL'
    CHANGING TRSP_KEYLEN.
  <VIM_CORR_KEYX>(TRSP_KEYLEN) = <TAB_KEY_X>(TRSP_KEYLEN).
  PERFORM UPDATE_CORR_KEYTAB USING CM_ACTION RETCODE.
  ADD: RETCODE TO RC, 1 TO COUNT.
  IF RC LT COUNT AND CM_ACTION NE PRUEFEN.
    CLEAR RC.
  ENDIF.

ENDFORM.
